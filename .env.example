# =============================================================================
# My Health Web — environment variables
# Copy to .env.local and adjust for your setup.
# =============================================================================

# Backend API base URL (CLIENT-VISIBLE — embedded in browser bundle)
# Default in code: http://localhost:3009
# Must match the Express server PORT (see companion repo).
NEXT_PUBLIC_API_URL=http://localhost:3009

# Landing page — GitHub and docs (CLIENT-VISIBLE — optional overrides)
NEXT_PUBLIC_GITHUB_ORG=Luckee-Core
NEXT_PUBLIC_GITHUB_WEB_URL=https://github.com/Luckee-Core/my-health-open-source
NEXT_PUBLIC_GITHUB_API_URL=https://github.com/Luckee-Core/my-health-open-source-express-server
# Defaults to Express docs: {api-repo}/blob/main/docs/README.md
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_THT_URL=https://www.trouthousetech.com

# NEVER put DATABASE_URL or other server secrets in NEXT_PUBLIC_* (Express-side only).
